# Rust build artifacts
target/

# Generated Datrie trie cache (rebuilt from words_th.txt on demand)
*.datrie.cache

# Source WordNet SQLite DB (11MB, NICT license) — we ship the derived
# wordnet_synonyms.tsv (~1MB) instead; re-fetch the .db only to regenerate it.
wordnet_th.db

# Kaikki (Wiktionary) raw download (~79MB) — fetched via scripts/fetch_kaikki.sh,
# never committed. CC BY-SA. Regenerate on demand.
kaikki_th.jsonl

# Generated served-page snapshot (regenerate via curl; the transcript is the
# real offline fallback and IS committed).
demo-fallback/index_snapshot.html

# macOS
.DS_Store

# ศัพท์บัญญัติ raw HTML cache (fetched once, offline; not committed)
data/coined_word_cache/

# WASM build artifacts (regenerate via wacha-wasm/web/build.sh)
wacha-wasm/target/
wacha-wasm/web/wacha_wasm.wasm
# Embedded reduced segmenter cache (regenerate via wacha/examples/gen_reduced_cache.rs)
wacha-wasm/assets/words_th.seg
