---
// WACHA Webapp - Astro scaffold (Round 13)
---
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WACHA — วันนี้อยากให้ภาษาไทยทำอะไรให้คุณ</title>
  <meta name="description" content="ระบบค้นคว้าพจนานุกรมและภาษาไทยอัตโนมัติ WACHA">

  <!-- Google Fonts: Sarabun & Krub -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Krub:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/style.css">
</head>
<body class="state-ambient">
  <!-- Visual Canvas for subtle ambient lighting -->
  <div class="ambient-background">
    <div class="light-orb orb-1"></div>
    <div class="light-orb orb-2"></div>
    <div class="light-orb orb-3"></div>
  </div>

  <!-- Kinetic Typography Viewport (Horizontal & Vertical Streams + Dynamic Word Cloud) -->
  <div class="kinetic-viewport" id="kineticViewport" aria-hidden="true">
    <!-- Horizontal Flowing Lines -->
    <div class="kinetic-stream-h stream-h-1" id="streamH1"></div>
    <div class="kinetic-stream-h stream-h-2" id="streamH2"></div>
    <div class="kinetic-stream-h stream-h-3" id="streamH3"></div>
    <div class="kinetic-stream-h stream-h-4" id="streamH4"></div>
    <div class="kinetic-stream-h stream-h-5" id="streamH5"></div>

    <!-- Vertical Flowing Lines -->
    <div class="kinetic-stream-v stream-v-1" id="streamV1"></div>
    <div class="kinetic-stream-v stream-v-2" id="streamV2"></div>
    <div class="kinetic-stream-v stream-v-3" id="streamV3"></div>
    <div class="kinetic-stream-v stream-v-4" id="streamV4"></div>
    <div class="kinetic-stream-v stream-v-5" id="streamV5"></div>

    <!-- Floating Dynamic Word Cloud -->
    <div class="words-cloud" id="wordsCloud"></div>
  </div>

  <!-- Top Micro-Bar (Status & Interactive Demo Controls) -->
  <header class="top-nav">
    <div class="brand-subtle">
      <span class="brand-spark">✦</span>
      <span class="brand-title">WACHA KINETIC</span>
    </div>

    <div class="theme-toggle-container">
      <button class="theme-toggle-btn" id="themeToggleBtn" aria-label="สลับโหมดมืด/สว่าง" title="สลับโหมดมืด/สว่าง">
        <svg class="theme-icon sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <span class="theme-toggle-text" id="themeToggleText">โหมดมืด</span>
      </button>
    </div>
  </header>

  <!-- Central Kinetic Stage -->
  <main class="stage-container" id="stageContainer">
    
    <!-- Greeting Headline Section: วันนี้อยากให้ภาษาไทยทำอะไรให้คุณ -->
    <div class="greeting-wrapper" id="greetingWrapper">
      <h1 class="greeting-headline" id="greetingHeadline" aria-label="วันนี้อยากให้ภาษาไทยทำอะไรให้คุณ">
        <span class="greeting-slot" id="targetSlot0" data-word="วันนี้"><span class="slot-text">วันนี้</span></span>
        <span class="greeting-slot" id="targetSlot1" data-word="อยากให้"><span class="slot-text">อยากให้</span></span>
        <span class="greeting-slot" id="targetSlot2" data-word="ภาษาไทย"><span class="slot-text">ภาษาไทย</span></span>
        <span class="greeting-slot" id="targetSlot3" data-word="ทำอะไร"><span class="slot-text">ทำอะไร</span></span>
        <span class="greeting-slot" id="targetSlot4" data-word="ให้คุณ"><span class="slot-text">ให้คุณ</span></span>
      </h1>
      <p class="greeting-subtext" id="greetingSubtext">
        พิมพ์คำถาม สิ่งที่ต้องการค้นหา ตั้งชื่อ แต่งคำประพันธ์ หรือสืบสายรากศัพท์
      </p>
    </div>

    <!-- Liquid Glass Textbox Container (Squircle Apple-style) -->
    <div class="glass-search-container" id="glassSearchContainer">
      <!-- Specular Refraction Highlights -->
      <div class="glass-lens-overlay" aria-hidden="true"></div>
      <div class="glass-specular-edge" aria-hidden="true"></div>

      <!-- Main Squircle Capsule Input -->
      <div class="liquid-textbox" id="liquidTextbox">
        
        <!-- Left Sparkle Icon -->
        <div class="sparkle-icon-wrapper" title="ระบบตื่นรู้และพร้อมรับคำสั่ง">
          <svg class="sparkle-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L14.2 9.8L22 12L14.2 14.2L12 22L9.8 14.2L2 12L9.8 9.8L12 2Z" fill="url(#sparkleGradient)" />
            <defs>
              <linearGradient id="sparkleGradient" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                <stop stop-color="#2563EB" />
                <stop offset="0.5" stop-color="#4F46E5" />
                <stop offset="1" stop-color="#7C3AED" />
              </linearGradient>
            </defs>
          </svg>
        </div>

        <!-- Loopless Clean Input Field -->
        <div class="input-field-wrapper">
          <input 
            type="text" 
            id="thaiSearchInput" 
            class="thai-input" 
            placeholder="พิมพ์คำถามหรือสิ่งที่คุณอยากรู้..." 
            autocomplete="off"
            spellcheck="false"
            aria-label="พิมพ์คำถามหรือสิ่งที่คุณอยากรู้"
          >
        </div>

        <!-- Right Action Button (Squircle / Capsule with Up Arrow) -->
        <button class="action-btn" id="actionSubmitBtn" aria-label="ส่งคำสั่ง" disabled>
          <svg class="arrow-up-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </button>
      </div>

      <!-- Mode Selection Container (โหลดขึ้นมาใต้ช่องพิมพ์ขณะพิมพ์) -->
      <div class="mode-selection-container" id="modeSelectionContainer" style="display: none;">
        <div class="mode-selection-header">
          <div class="mode-loading-indicator" id="modeLoadingIndicator">
            <span class="pulse-spark">✦</span>
            <span class="mode-header-text">โหมดการวิเคราะห์สำหรับ "<strong id="typedWordLabel" class="highlight-word">...</strong>"</span>
          </div>
          <span class="mode-select-hint">เลือกเพื่อดูคำตอบ</span>
        </div>

        <div class="mode-cards-grid">
          <!-- ก้อนที่ 1: ค้นหาทั่วไป (General Search via WACHA) -->
          <button class="mode-card" id="modeCardGeneral" data-mode="general">
            <div class="mode-card-icon-box dict-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <div class="mode-card-info">
              <div class="mode-title-row">
                <span class="mode-title">1. ค้นหาทั่วไป</span>
                <span class="mode-tag tag-dict">WACHA Engine</span>
              </div>
              <p class="mode-desc">
                นิยาม, แผนภาพความสัมพันธ์ และคำที่เกี่ยวข้อง สำหรับ "<span class="echo-word">คำนี้</span>"
              </p>
            </div>
            <div class="mode-action-indicator">
              <span class="action-arrow">→</span>
            </div>
          </button>

          <!-- ก้อนที่ 2: การหารากศัพท์ (Etymological Bridge) -->
          <button class="mode-card" id="modeCardEtymology" data-mode="etymology">
            <div class="mode-card-icon-box root-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
            </div>
            <div class="mode-card-info">
              <div class="mode-title-row">
                <span class="mode-title">2. การหารากศัพท์</span>
                <span class="mode-tag tag-pie">PIE Cognates</span>
              </div>
              <p class="mode-desc">
                สืบสายรากศัพท์บาลี-สันสกฤต และคำร่วมเชื้อสาย PIE สำหรับ "<span class="echo-word">คำนี้</span>"
              </p>
            </div>
            <div class="mode-action-indicator">
              <span class="action-arrow">→</span>
            </div>
          </button>
        </div>
      </div>

    </div>

    <!-- Interactive Execution Response Card (Liquid Glass Drawer) -->
    <div class="response-drawer" id="responseDrawer">
      <div class="response-card liquid-glass-card">
        <div class="response-header">
          <div class="response-badge">
            <span class="pulse-dot"></span>
            <span id="responseStatusText">วิเคราะห์ภาษาไทยสำเร็จ</span>
          </div>
          <button class="response-close-btn" id="closeResponseBtn" title="ปิดหน้าต่าง">✕</button>
        </div>
        <div class="response-body" id="responseBody">
          <!-- Dynamic Response Content -->
        </div>
      </div>
    </div>

  </main>

  <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
  <script is:inline src="/d3_graph.js"></script>
  <script is:inline src="/app.js"></script>
</body>
</html>
